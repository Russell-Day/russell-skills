[Unit]
Description=Archive delegated T3 worker threads settled more than 5 days ago

[Service]
Type=oneshot
# PATH must reach node 22+; with nvm add its bin dir, e.g. %h/.nvm/versions/node/<version>/bin.
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env node %h/.agents/skills/subagents/code/prune-workers.mjs --days 5
